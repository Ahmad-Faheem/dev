# Copy this file to .env and fill in the values. .env is not committed to git.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string used to sign login tokens, e.g. from: openssl rand -hex 32
SECRET_KEY=change-me
# PostgreSQL connection. Leave unset to use a local SQLite file instead.
# DATABASE_URL=postgresql://foundry:password@127.0.0.1:5432/foundry
